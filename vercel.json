{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/happy-birthday.mp3",
      "dest": "/happy-birthday.mp3"
    },
    {
      "src": "/profile.png",
      "dest": "/profile.png"
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}
